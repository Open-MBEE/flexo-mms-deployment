	gniso:dateFeatureEdited "2021-06-04"^^xsd:date ;
	gniso:description "The geographic center of the State, or that point on which a surface of uniform thickness would balance, is located in Hawaii County, on Maui Island at 20?15' North, 156?20' West."@en ;
	gniso:history "Hawaii officially became the 50th state in the American Union on August 21, 1959.  \"Hawaii\" is a Polynesian word applied to the largest of the islands and extended to the whole archipelago during the 19th century.  The English explorer Captain James Cook named them the Sandwich Islands for the first Lord of the Admiralty, the Earl of Sandwich.  (U.S. Geological Survey (USGS) News Release: Origin of The Names of The States)"@en ;
	gniso:officialName "State of Hawaii"@en ;
	gniso:citation "US Public Law - Congressional Record - include year law was passed. Use code US-T120. US 1959"@en ;
	gniso:alternativeName "Sandwich Islands"@en, "State of Hawai‘i"@en, "Territorio do Havai *"@en, "Territory of Hawaii"@en ;
	gniso:country gnisfa:United_States ;
	gniso:stateId "15" ;
	gniso:stateCode "HI" ;
	gniso:stateName "Hawaii"@en .

