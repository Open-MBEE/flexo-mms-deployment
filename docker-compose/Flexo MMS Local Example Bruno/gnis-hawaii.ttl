	geosparql:hasGeometry gnisg:gnisf.365442 ;
	gniso:elevation gniso:Elevation.13ft ;
	gniso:mapName "Kaena"@en ;
	gniso:dateFeatureCreated "1994-09-01"^^xsd:date ;
	gniso:dateFeatureEdited "2021-06-23"^^xsd:date ;
	gniso:description "Facility is located 2 mi W from Mokuleia.  Used primarily for gliding operations."@en ;
	gniso:history "Established in the 1920's as Kawaihapai Military Reservation; redesignated at the beginning of WW II as Moku-l`ia Airfield.  In 1948, the airfield was inactivated and renamed Dillingham Air Force Base for Captain Henry Gaylord Dillingham, a B-29 pilot who died in action in Japan in 1945.  Original Hawaiian name means \"lifted water\"."@en ;
	gniso:officialName "Dillingham Airfield"@en ;
	gniso:citation "Federal Aviation Administration (FAA) listing of airports and other landing areas in the United States with associated information, 1981. Now available in CD format published quarterly. The year and month of the CD follows if known:  940903"@en ;
	gniso:alternativeName "Dillingham Air Force Base"@en, "Dillingham Field"@en, "Dillingham Military Reservation"@en, "Kawaihapai Military Reservation"@en, "Moku-l‘ia Airfield"@en, "Mokuleia Airfield (historical)"@en .

