meta {
  name: query scratch
  type: http
  seq: 19
}

post {
  url: {{host}}/orgs/openmbee/repos/test/scratches/unversioned/query
  body: sparql
  auth: inherit
}

headers {
  Content-Type: application/sparql-query
}

body:sparql {
  select * where {?s ?p ?o .}
}

settings {
  encodeUrl: true
  timeout: 0
}
