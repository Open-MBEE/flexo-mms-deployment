meta {
  name: load master model again
  type: http
  seq: 10
}

put {
  url: {{host}}/orgs/openmbee/repos/test/branches/master/graph
  body: text
  auth: inherit
}

headers {
  content-type: text/turtle
}

body:text {
  @prefix : <https://mms.openmbee.org/demos/people/> .
  @prefix foaf: <http://xmlns.com/foaf/0.1/> .
  
  :Cathy a :Person ;
        foaf:name "Cathy" .
  :Bun a :Bunny ;
        :owner :Cathy ;
        :likes :Lettuce ;
        foaf:name "Bun" .
}

settings {
  encodeUrl: true
  timeout: 0
}
