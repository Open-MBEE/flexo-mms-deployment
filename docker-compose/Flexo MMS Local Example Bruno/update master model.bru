meta {
  name: update master model
  type: http
  seq: 8
}

post {
  url: {{host}}/orgs/openmbee/repos/test/branches/master/update
  body: text
  auth: inherit
}

headers {
  content-type: application/sparql-update
}

body:text {
  prefix : <https://mms.openmbee.org/demos/people/>
  prefix foaf: <http://xmlns.com/foaf/0.1/>
  
  delete where {
    ?s ?p ?o .
  };
  insert data {
      :Bob a :Person ;
          foaf:name "Bob" .
  
      :Fluffy a :Cat ;
          :owner :Bob ;
          :likes :Jelly ;
          foaf:name "Fluffy" .
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
