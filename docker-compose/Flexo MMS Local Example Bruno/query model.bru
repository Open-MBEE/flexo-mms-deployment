meta {
  name: query model
  type: http
  seq: 6
}

post {
  url: {{host}}/orgs/openmbee/repos/test/branches/master/query
  body: text
  auth: inherit
}

headers {
  content-type: application/sparql-query
}

body:text {
  prefix : <https://mms.openmbee.org/demos/people/>
  prefix foaf: <http://xmlns.com/foaf/0.1/>
  
  select * {
    ?s ?p ?o
  } limit 10
  
}

settings {
  encodeUrl: true
  timeout: 0
}
