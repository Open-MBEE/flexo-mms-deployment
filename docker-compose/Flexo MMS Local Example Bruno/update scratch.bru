meta {
  name: update scratch
  type: http
  seq: 12
}

post {
  url: {{host}}/orgs/openmbee/repos/test/scratches/unversioned/update
  body: text
  auth: inherit
}

headers {
  content-type: application/sparql-update
}

body:text {
  prefix : <https://mms.openmbee.org/demos/people/>
  prefix foaf: <http://xmlns.com/foaf/0.1/>
  
  insert data {
      :Bob  :likes :Alice .
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
