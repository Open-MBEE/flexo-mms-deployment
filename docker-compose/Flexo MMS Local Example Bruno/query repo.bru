meta {
  name: query repo
  type: http
  seq: 13
}

post {
  url: {{host}}/orgs/openmbee/repos/test/query
  body: text
  auth: inherit
}

headers {
  content-type: application/sparql-query
}

body:text {
  prefix mms: <https://mms.openmbee.org/rdf/ontology/>
  
  select ?ref ?commit ?time ?parent where {
  	?ref mms:commit ?commit .
  	?commit mms:submitted  ?time ;
            mms:parent ?parent .
  } 
}

settings {
  encodeUrl: true
  timeout: 0
}
